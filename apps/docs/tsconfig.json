{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", "public", "registry/generated"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["bun"],
    "baseUrl": ".",
    "resolveJsonModule": true,
    "paths": {
      "@/components/location-picker": [
        "./registry/location-picker/location-picker.tsx"
      ],
      "@/components/cameroon-map": ["./registry/cameroon-map/cameroon-map.tsx"],
      "@/components/cameroon-map-leaflet": [
        "./registry/cameroon-map/cameroon-map-leaflet.tsx"
      ],
      "@/lib/cameroon-locations/*": ["../../packages/cameroon-locations/src/*"],
      "@/*": ["./src/*"],
      "cameroon-locations": ["../../packages/cameroon-locations/src/index.ts"],
      "cameroon-locations/geojson/*": [
        "../../packages/cameroon-locations/geojson/*"
      ],
      "cameroon-locations/*": ["../../packages/cameroon-locations/src/*.ts"]
    }
  }
}
