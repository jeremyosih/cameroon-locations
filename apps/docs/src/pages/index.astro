---
import { render } from "astro:content";
import InstallCommand from "@/components/docs/InstallCommand";
import Docs from "@/layouts/Docs.astro";
import { getDocs, sourcePath } from "@/lib/docs";
import { mdxComponents } from "@/lib/mdx-components";
import { GITHUB_URL } from "@/site";

const entry = (await getDocs()).find((e) => e.id === "introduction");
if (!entry) throw new Error("introduction.mdx is missing");
const { Content, headings } = await render(entry);
---

<Docs
  slug="introduction"
  title={entry.data.title}
  description={entry.data.description}
  headings={headings}
  source={sourcePath(entry)}
  hero
>
  <header slot="hero" class="mb-12">
    <p class="text-muted-foreground mb-5 inline-flex items-center gap-2 rounded-full border px-2.5 py-0.5 text-xs">
      <span class="bg-brand size-1.5 rounded-full"></span>
      TypeScript · zero dependencies · MIT
    </p>
    <h1 class="max-w-xl text-3xl leading-[1.15] font-semibold tracking-tight text-balance sm:text-[2.1rem]">
      Cameroon's administrative divisions, as typed data.
    </h1>
    <p class="text-muted-foreground mt-4 max-w-xl text-[15px] leading-relaxed">
      {entry.data.description}
    </p>
    <div class="mt-7 max-w-md">
      <InstallCommand client:load />
    </div>
    <div class="-mt-1 flex gap-2">
      <a
        href="/docs/installation"
        class="bg-primary text-primary-foreground hover:bg-primary/90 inline-flex h-9 items-center rounded-md px-4 text-sm font-medium transition-colors"
      >
        Get started
      </a>
      <a
        href={GITHUB_URL}
        class="hover:bg-accent inline-flex h-9 items-center rounded-md border px-4 text-sm font-medium transition-colors"
      >
        GitHub
      </a>
    </div>
  </header>
  <Content components={mdxComponents} />
</Docs>
