---
/**
 * The boundary files shipped in `packages/cameroon-locations/geojson`, read
 * at build time: level, detail, feature count and size.
 */
import { readdirSync, readFileSync, statSync } from "node:fs";
import { join, resolve } from "node:path";

const dir = resolve(process.cwd(), "../../packages/cameroon-locations/geojson");

const LEVELS = ["country", "regions", "divisions", "arrondissements"];
const DETAIL = { low: 0, default: 1, high: 2 } as const;
type Detail = keyof typeof DETAIL;

interface Row {
  file: string;
  level: string;
  detail: Detail;
  features: number;
  kb: number;
}

const rows: Row[] = readdirSync(dir)
  .filter((f) => /\.(geo|topo)\.json$/.test(f))
  .map((file) => {
    const path = join(dir, file);
    const json = JSON.parse(readFileSync(path, "utf8")) as {
      features?: unknown[];
      objects?: Record<string, { geometries?: unknown[] }>;
    };
    const topo = file.endsWith(".topo.json");
    const detail: Detail = file.includes(".low.")
      ? "low"
      : file.includes(".high.")
        ? "high"
        : "default";
    const features = topo
      ? Object.values(json.objects ?? {}).reduce(
          (n, o) => n + (o.geometries?.length ?? 0),
          0,
        )
      : (json.features?.length ?? 0);
    return {
      file,
      level: topo ? "all four (TopoJSON)" : (file.split(".")[0] ?? ""),
      detail,
      features,
      kb: Math.round(statSync(path).size / 1024),
    };
  })
  .sort(
    (a, b) =>
      (LEVELS.indexOf(a.level) + 1 || 9) - (LEVELS.indexOf(b.level) + 1 || 9) ||
      DETAIL[a.detail] - DETAIL[b.detail],
  );
---

<div class="not-prose my-6 overflow-x-auto rounded-lg border">
  <table class="w-full text-left text-sm">
    <thead class="bg-muted/50 text-muted-foreground border-b text-xs">
      <tr>
        <th class="px-4 py-2.5 font-medium">cameroon-locations/geojson/…</th>
        <th class="px-4 py-2.5 font-medium">Level</th>
        <th class="px-4 py-2.5 font-medium">Detail</th>
        <th class="px-4 py-2.5 text-right font-medium">Features</th>
        <th class="px-4 py-2.5 text-right font-medium">Size</th>
      </tr>
    </thead>
    <tbody class="divide-y">
      {
        rows.map((r) => (
          <tr>
            <td class="px-4 py-2 font-mono text-[0.8125rem] whitespace-nowrap">
              {r.file}
            </td>
            <td class="text-muted-foreground px-4 py-2">{r.level}</td>
            <td class="text-muted-foreground px-4 py-2">{r.detail}</td>
            <td class="text-muted-foreground px-4 py-2 text-right tabular-nums">
              {r.features}
            </td>
            <td class="text-muted-foreground px-4 py-2 text-right whitespace-nowrap tabular-nums">
              {r.kb} KB
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
