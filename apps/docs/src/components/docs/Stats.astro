---
/** Dataset totals, read from the package at build time. */
import { counts, formatCount } from "@/lib/package-data";

const items = [
  { n: counts.regions, label: "Regions", code: "CM002" },
  { n: counts.divisions, label: "Divisions", code: "CM002007" },
  { n: counts.arrondissements, label: "Arrondissements", code: "CM002007001" },
  { n: counts.cantons, label: "Cantons", code: "…-C01" },
  { n: counts.villages, label: "Villages", code: "…-C01-V001" },
];
---

<div class="not-prose my-8 grid grid-cols-2 overflow-hidden rounded-lg border sm:grid-cols-5">
  {
    items.map((item, i) => (
      <div
        class:list={[
          "flex flex-col gap-1 px-4 py-4",
          i > 0 && "sm:border-l",
          i % 2 === 1 && "border-l sm:border-l",
          i > 1 && "border-t sm:border-t-0",
          i === 4 && "col-span-2 sm:col-span-1",
        ]}
      >
        <span class="text-2xl font-medium tracking-tight tabular-nums">
          {formatCount(item.n)}
        </span>
        <span class="text-muted-foreground text-xs">{item.label}</span>
        <code class="text-muted-foreground/80 mt-1 font-mono text-[11px]">
          {item.code}
        </code>
      </div>
    ))
  }
</div>
