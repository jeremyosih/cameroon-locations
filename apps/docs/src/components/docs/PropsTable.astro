---
/**
 * API table for component props or function parameters.
 *
 * ```mdx
 * <PropsTable rows={[
 *   { name: "value", type: "Pcode | undefined", description: "Selected unit." },
 *   { name: "level", type: '"region" | "division" | "arrondissement"', default: '"arrondissement"', description: "Deepest level to pick." },
 * ]} />
 * ```
 */
export interface PropRow {
  name: string;
  type: string;
  default?: string;
  required?: boolean;
  description: string;
}

interface Props {
  rows: readonly PropRow[];
  /** Heading for the first column. Default "Prop". */
  label?: string;
}

const { rows, label = "Prop" } = Astro.props;
const hasDefaults = rows.some((r) => r.default !== undefined);
---

<div class="not-prose my-6 w-full overflow-x-auto rounded-lg border">
  <table class="w-full text-left text-sm">
    <thead class="bg-muted/50 text-muted-foreground border-b text-xs">
      <tr>
        <th class="px-4 py-2.5 font-medium">{label}</th>
        <th class="px-4 py-2.5 font-medium">Type</th>
        {hasDefaults && <th class="px-4 py-2.5 font-medium">Default</th>}
        <th class="px-4 py-2.5 font-medium">Description</th>
      </tr>
    </thead>
    <tbody class="divide-y">
      {
        rows.map((row) => (
          <tr class="align-top">
            <td class="px-4 py-3 font-mono text-[0.8125rem] whitespace-nowrap">
              {row.name}
              {row.required && <span class="text-brand ml-0.5">*</span>}
            </td>
            <td class="text-muted-foreground px-4 py-3 font-mono text-[0.8125rem]">
              {row.type}
            </td>
            {hasDefaults && (
              <td class="text-muted-foreground px-4 py-3 font-mono text-[0.8125rem] whitespace-nowrap">
                {row.default ?? "–"}
              </td>
            )}
            <td class="px-4 py-3 leading-relaxed">{row.description}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
