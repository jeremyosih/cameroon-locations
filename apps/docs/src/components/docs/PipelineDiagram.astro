---
/** sources → canonical → package, as plain boxes. */
const stages = [
  {
    title: "data/sources",
    body: "Untouched downloads, checksums and SOURCE.md per source. Git LFS.",
    items: ["OCHA COD-AB", "BUCREP RGPH 2005", "ELECAM 2025", "geoBoundaries"],
  },
  {
    title: "data/canonical",
    body: "One JSON per level keyed by P-code. Every value carries its source id.",
    items: ["patches/", "crosswalks/", "decisions/", "issues.json"],
  },
  {
    title: "cameroon-locations",
    body: "Generated, frozen records and simplified GeoJSON. Zero dependencies.",
    items: ["generated/*.json", "geojson/*", "dist/"],
  },
];
---

<div class="not-prose my-8 grid items-stretch gap-3 md:grid-cols-[1fr_auto_1fr_auto_1fr]">
  {
    stages.map((s, i) => (
      <>
        {i > 0 && (
          <div class="text-muted-foreground flex items-center justify-center text-sm" aria-hidden="true">
            <span class="hidden md:inline">→</span>
            <span class="md:hidden">↓</span>
          </div>
        )}
        <div class:list={["rounded-lg border p-4", i === 2 && "border-brand/40 bg-brand-soft"]}>
          <p class="font-mono text-[13px] font-medium">{s.title}</p>
          <p class="text-muted-foreground mt-1.5 text-xs leading-relaxed">{s.body}</p>
          <ul class="mt-3 flex flex-wrap gap-1.5">
            {s.items.map((item) => (
              <li class="bg-muted text-muted-foreground rounded px-1.5 py-0.5 font-mono text-[11px]">
                {item}
              </li>
            ))}
          </ul>
        </div>
      </>
    ))
  }
</div>
