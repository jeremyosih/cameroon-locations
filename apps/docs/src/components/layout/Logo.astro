---
/**
 * The flag of Cameroon, as the 🇨🇲 emoji. Decorative: it always sits next to
 * the site name, which carries the accessible label. Size it with a
 * `text-*` class. Windows has no flag emoji and shows the letters "CM".
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<span
  class:list={["inline-block leading-none select-none", className]}
  aria-hidden="true">🇨🇲</span
>
