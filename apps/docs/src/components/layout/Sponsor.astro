---
import { SPONSOR } from "@/site";

/**
 * "Brought to you by the SDF" credit. The logo is black line art on a white
 * disc, so it stays legible on the dark theme too.
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<a
  href={SPONSOR.url}
  target="_blank"
  rel="noopener noreferrer"
  class:list={[
    "text-muted-foreground hover:text-foreground group inline-flex items-center gap-2 text-xs transition-colors",
    className,
  ]}
>
  <img
    src={SPONSOR.logo}
    alt=""
    width="20"
    height="20"
    loading="lazy"
    decoding="async"
    class="size-5 shrink-0 rounded-full ring-1 ring-black/5 dark:ring-white/10"
  />
  <span>
    Brought to you by the <abbr
      title={SPONSOR.name}
      class="text-foreground/85 group-hover:text-foreground font-medium no-underline">SDF</abbr
    >
  </span>
</a>
