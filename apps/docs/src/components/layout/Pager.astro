---
import { PAGES, pagePath } from "@/site";

interface Props {
  current: string;
}

const index = PAGES.findIndex((p) => p.slug === Astro.props.current);
const prev = index > 0 ? PAGES[index - 1] : undefined;
const next = index >= 0 ? PAGES[index + 1] : undefined;
---

<nav class="mt-20 grid grid-cols-2 gap-4 border-t border-dashed pt-6 text-sm" aria-label="Pagination">
  <div>
    {
      prev && (
        <a href={pagePath(prev.slug)} class="group flex flex-col gap-1">
          <span class="text-muted-foreground text-xs">Previous</span>
          <span class="group-hover:text-brand transition-colors">← {prev.label}</span>
        </a>
      )
    }
  </div>
  <div class="text-right">
    {
      next && (
        <a href={pagePath(next.slug)} class="group flex flex-col items-end gap-1">
          <span class="text-muted-foreground text-xs">Next</span>
          <span class="group-hover:text-brand transition-colors">{next.label} →</span>
        </a>
      )
    }
  </div>
</nav>
