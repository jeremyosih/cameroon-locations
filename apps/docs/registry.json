{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "cameroon-locations",
  "homepage": "{{SITE_URL}}",
  "items": [
    {
      "name": "cameroon-locations-core",
      "type": "registry:lib",
      "title": "Cameroon locations core",
      "description": "Copy-paste version of the cameroon-locations core: types, sources and attribution, name normalisation, lookups and search over the 10 regions, 58 divisions and 360 arrondissements, with the data inlined. No npm dependency.",
      "meta": {
        "vendor": "../../packages/cameroon-locations/src",
        "target": "lib/cameroon-locations"
      },
      "files": [
        { "path": "types.ts", "type": "registry:lib" },
        { "path": "sources.ts", "type": "registry:lib" },
        { "path": "normalize.ts", "type": "registry:lib" },
        { "path": "lookup.ts", "type": "registry:lib" },
        { "path": "search.ts", "type": "registry:lib" },
        { "path": "data/admin.ts", "type": "registry:lib" }
      ]
    },
    {
      "name": "location-picker",
      "type": "registry:component",
      "title": "Location picker",
      "description": "Cascading region, division and arrondissement picker for Cameroon, with accent- and typo-tolerant search in French and English. Values are OCHA P-codes. Built on Popover and Command; data comes from the cameroon-locations-core item, so there is no npm dependency.",
      "registryDependencies": [
        "{{SITE_URL}}/r/cameroon-locations-core.json",
        "popover",
        "command",
        "button"
      ],
      "files": [
        {
          "path": "registry/location-picker/location-picker.tsx",
          "type": "registry:component"
        }
      ]
    },
    {
      "name": "cameroon-map",
      "type": "registry:component",
      "title": "Cameroon map",
      "description": "Map of Cameroon's regions, divisions or arrondissements on Leaflet (react-leaflet): selection, tooltips, a sequential choropleth keyed by P-code, drill-down, a layers menu and fullscreen. Boundaries come from the cameroon-locations npm package and are credited in the attribution control.",
      "dependencies": [
        "cameroon-locations",
        "leaflet",
        "react-leaflet",
        "maplibre-gl@^5",
        "@maplibre/maplibre-gl-leaflet"
      ],
      "devDependencies": ["@types/geojson", "@types/leaflet"],
      "registryDependencies": ["button", "button-group"],
      "css": {
        "@layer base": {
          ".leaflet-container": { "@apply !bg-card !font-[inherit]": {} },
          ".leaflet-container a": { "@apply !text-inherit": {} },
          ".leaflet-div-icon": { "@apply !bg-transparent !border-none": {} },
          ".leaflet-popup-content-wrapper, .leaflet-popup-content, .leaflet-popup-content p": {
            "@apply ![all:unset]": {}
          },
          ".leaflet-popup": { "@apply !animate-none": {} },
          ".leaflet-popup-close-button": {
            "@apply ring-offset-background focus:ring-ring bg-secondary rounded-xs opacity-70 transition-opacity hover:opacity-100 focus:ring-2 focus:outline-hidden": {}
          },
          ".leaflet-tooltip": {
            "@apply !bg-foreground !text-background !animate-none !rounded-md !border-none !p-0 !px-3 !py-1.5 !shadow-none": {}
          },
          ".leaflet-popup-tip-container, .leaflet-tooltip-top:before, .leaflet-tooltip-bottom:before, .leaflet-tooltip-left:before, .leaflet-tooltip-right:before": {
            "@apply hidden": {}
          },
          ".leaflet-control-attribution": {
            "@apply !bg-muted rounded-md !px-[4px] !py-[2px] text-[10px] !leading-none !text-inherit": {}
          }
        }
      },
      "cssVars": {
        "light": {
          "choropleth-1": "#b7d3f6",
          "choropleth-2": "#6da7ec",
          "choropleth-3": "#2a78d6",
          "choropleth-4": "#184f95",
          "choropleth-5": "#0d366b"
        },
        "dark": {
          "choropleth-1": "#0d366b",
          "choropleth-2": "#1c5cab",
          "choropleth-3": "#3987e5",
          "choropleth-4": "#86b6ef",
          "choropleth-5": "#cde2fb"
        }
      },
      "files": [
        {
          "path": "registry/cameroon-map/cameroon-map.tsx",
          "type": "registry:component"
        },
        {
          "path": "registry/cameroon-map/cameroon-map-leaflet.tsx",
          "type": "registry:component"
        },
        {
          "path": "registry/cameroon-map/cameroon-map-scale.ts",
          "type": "registry:component"
        }
      ]
    }
  ]
}
