{
  "name": "cameroon-locations-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "bun run --filter cameroon-locations build",
    "test": "bun run --filter cameroon-locations test",
    "typecheck": "bun run --filter '*' typecheck",
    "check": "biome check .",
    "fix": "biome check --write .",
    "data:canonical": "cd data && ./tools/build-all.sh",
    "data:generate": "bun run --filter cameroon-locations generate",
    "data:geo": "bun run --filter cameroon-locations geo",
    "docs:dev": "bun run --filter docs dev",
    "docs:build": "bun run --filter docs build",
    "changeset": "changeset",
    "release": "bun run build && changeset publish",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@changesets/cli": "^3.0.3",
    "husky": "^9.1.7",
    "typescript": "^5.9.3"
  }
}
